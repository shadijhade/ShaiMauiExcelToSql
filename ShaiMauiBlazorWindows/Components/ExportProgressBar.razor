@if (IsVisible)
{
    <div class="position-fixed top-0 start-0 end-0 bottom-0 d-flex justify-content-center align-items-center" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="card" style="width: 400px;">
            <div class="card-header">
                <h5 class="mb-0">Exporting to Excel</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p>@StatusMessage</p>
                </div>
                <div class="progress">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                         role="progressbar" 
                         style="width: @(Progress)%;" 
                         aria-valuenow="@Progress" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                        @Progress%
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }
    
    [Parameter]
    public int Progress { get; set; }
    
    [Parameter]
    public string StatusMessage { get; set; } = "Please wait while your data is being exported...";
}