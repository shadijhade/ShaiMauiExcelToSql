@namespace ShaiMauiBlazorWindows.Components.Layout
@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-ghost btn-icon btn-sm" onclick="toggleTheme()" title="Toggle theme">
                    <span class="material-symbols-outlined icon" id="theme-icon" style="font-size: 1.25rem;line-height: .75;">dark_mode</span>
                </button>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                
            }
            catch (Exception)
            {
                // Silently fail if icon initialization fails
            }
        }
    }
}
