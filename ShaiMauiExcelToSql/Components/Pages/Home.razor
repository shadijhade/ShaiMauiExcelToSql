@page "/"

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <h1 class="display-4 font-semibold mb-3">SQL Server Query Tool</h1>
                <p class="lead text-muted">A powerful and intuitive tool for database management and query execution</p>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-opacity-10 me-3 rounded-circle" style="width: 50px;height: 50px;display: flex;align-items: center; justify-content: center;">
                                    <span class="material-symbols-outlined" style="font-size: 2.5rem;">database</span>
                                </div>
                                <h5 class="card-title mb-0">Database Connection</h5>
                            </div>
                            <p class="card-text text-muted">Connect to SQL Server databases using secure connection strings with support for various authentication methods.</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-opacity-10 me-3 rounded-circle" style="width: 50px;height: 50px;display: flex;align-items: center; justify-content: center;">
                                    <span class="material-symbols-outlined" style="font-size: 2.5rem;">code</span>
                                </div>
                                <h5 class="card-title mb-0">SQL Query Execution</h5>
                            </div>
                            <p class="card-text text-muted">Execute complex SQL queries with syntax highlighting, auto-completion, and real-time performance metrics.</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-opacity-10 me-3 rounded-circle" style="width: 50px;height: 50px;display: flex;align-items: center; justify-content: center;">
                                    <span class="material-symbols-outlined" style="font-size: 2.5rem;">table</span>
                                </div>
                                <h5 class="card-title mb-0">Results Visualization</h5>
                            </div>
                            <p class="card-text text-muted">View query results in an intuitive table format with sorting, filtering, and pagination capabilities.</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-opacity-10 me-3 rounded-circle" style="width: 50px;height: 50px;display: flex;align-items: center; justify-content: center;">
                                    <span class="material-symbols-outlined" style="font-size: 2.5rem;">arrow_upload_progress</span>
                                </div>
                                <h5 class="card-title mb-0">Excel Export</h5>
                            </div>
                            <p class="card-text text-muted">Export query results to Excel with advanced formatting options, multiple worksheets, and custom styling.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <a href="/sqlquery" class="btn btn-primary btn-lg">
                    <span class="material-symbols-outlined icon">play_arrow</span>
                    Start Querying
                </a>
            </div>
        </div>
    </div>
</div>

@inject IJSRuntime JSRuntime

@code {
    
}
