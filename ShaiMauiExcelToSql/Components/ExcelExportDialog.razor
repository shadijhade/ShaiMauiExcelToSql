@using ShaiMauiExcelToSql.Models
@using ShaiMauiExcelToSql.Services
@using System.Data
@using CommunityToolkit.Maui.Storage
@inject ExcelExportSettingsService SettingsService
@inject DatabaseService DatabaseService
@inject IFolderPicker FolderPicker
<div class="modal fade @(IsVisible ? "show" : "")" style="display: @(IsVisible ? "block" : "none"); background-color: rgba(0,0,0,0.5);" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Excel Export Options</h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Basic Options</h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label for="worksheetName" class="form-label">Worksheet Name</label>
                                    <input type="text" class="form-control" id="worksheetName" @bind="options.WorksheetName" />
                                </div>
                                <div class="mb-3">
                                    <label for="fileNamePrefix" class="form-label">File Name Prefix</label>
                                    <input type="text" class="form-control" id="fileNamePrefix" @bind="options.FileNamePrefix" />
                                </div>
                                <div class="mb-3">
                                    <label for="customSavePath" class="form-label">Custom Save Location</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="customSavePath" @bind="options.CustomSavePath" 
                                               placeholder="Leave empty to use default location" />
                                        <button class="btn btn-outline-secondary" type="button" @onclick="PickSaveLocation">
                                            <i class="bi bi-folder"></i>
                                        </button>
                                    </div>
                                    <small class="form-text text-muted">
                                        Leave empty to save in the default location. Click the folder icon to choose a folder.
                                    </small>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="includeHeaderRow" @bind="options.IncludeHeaderRow">
                                    <label class="form-check-label" for="includeHeaderRow">
                                        Include Header Row
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="autoFitColumns" @bind="options.AutoFitColumns">
                                    <label class="form-check-label" for="autoFitColumns">
                                        Auto-fit Columns
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="openAfterExport" @bind="options.OpenAfterExport">
                                    <label class="form-check-label" for="openAfterExport">
                                        Open After Export
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Data Options</h6>
                            </div>
                            <div class="card-body">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="applyDataFormatting" @bind="options.ApplyDataFormatting">
                                    <label class="form-check-label" for="applyDataFormatting">
                                        Apply Data Formatting
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="formatDatesAsDate" @bind="options.FormatDatesAsDate">
                                    <label class="form-check-label" for="formatDatesAsDate">
                                        Format Dates as Date
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="formatNumbersAsNumbers" @bind="options.FormatNumbersAsNumbers">
                                    <label class="form-check-label" for="formatNumbersAsNumbers">
                                        Format Numbers as Numbers
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="exportAllRows" @bind="options.ExportAllRows">
                                    <label class="form-check-label" for="exportAllRows">
                                        Export All Rows
                                    </label>
                                </div>
                                @if (!options.ExportAllRows)
                                {
                                    <div class="mb-3">
                                        <label for="maxRowsToExport" class="form-label">Max Rows to Export</label>
                                        <input type="number" class="form-control" id="maxRowsToExport" @bind="options.MaxRowsToExport" min="1" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Formatting Options</h6>
                            </div>
                            <div class="card-body">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="applyTableStyle" @bind="options.ApplyTableStyle">
                                    <label class="form-check-label" for="applyTableStyle">
                                        Apply Table Style
                                    </label>
                                </div>
                                @if (options.ApplyTableStyle)
                                {
                                    <div class="mb-3">
                                        <label for="tableStyleName" class="form-label">Table Style</label>
                                        <select class="form-select" id="tableStyleName" @bind="options.TableStyleName">
                                            @foreach (var style in tableStyles)
                                            {
                                                <option value="@style">@style</option>
                                            }
                                        </select>
                                    </div>
                                }
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="alternatingRowColors" @bind="options.AlternatingRowColors">
                                    <label class="form-check-label" for="alternatingRowColors">
                                        Alternating Row Colors
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Header Formatting</h6>
                            </div>
                            <div class="card-body">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="boldHeaders" @bind="options.BoldHeaders">
                                    <label class="form-check-label" for="boldHeaders">
                                        Bold Headers
                                    </label>
                                </div>
                                <div class="mb-3">
                                    <label for="headerBackgroundColor" class="form-label">Header Background Color</label>
                                    <input type="color" class="form-control form-control-color" id="headerBackgroundColor" @bind="options.HeaderBackgroundColor" />
                                </div>
                                <div class="mb-3">
                                    <label for="headerFontColor" class="form-label">Header Font Color</label>
                                    <input type="color" class="form-control form-control-color" id="headerFontColor" @bind="options.HeaderFontColor" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">Column Formatting</h6>
                    </div>
                    <div class="card-body">
                        <p>Customize individual column formatting, headers, and appearance.</p>
                        <button class="btn btn-outline-primary" @onclick="ShowColumnFormatting">
                            <i class="bi bi-table"></i> Configure Column Formatting
                        </button>
                        
                        @if (options.ColumnFormattings.Count > 0)
                        {
                            <div class="mt-3">
                                <h6>Customized Columns:</h6>
                                <ul class="list-group">
                                    @foreach (var formatting in options.ColumnFormattings)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @formatting.ColumnName
                                            @if (!string.IsNullOrEmpty(formatting.CustomHeaderText))
                                            {
                                                <span class="badge bg-primary">Custom Header: @formatting.CustomHeaderText</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                
                <div class="d-flex justify-content-end mt-3">
                    <button class="btn btn-outline-secondary me-2" @onclick="ResetToDefaults">Reset to Defaults</button>
                    <button class="btn btn-outline-primary me-2" @onclick="SaveAsDefault">Save as Default</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="OnConfirm">Export</button>
            </div>
        </div>
    </div>
</div>

<ColumnFormattingDialog 
    IsVisible="@showColumnFormattingDialog"
    IsVisibleChanged="@((value) => showColumnFormattingDialog = value)"
    Columns="@(DataTable?.Columns ?? null)"
    ExportOptions="@options"
    OnFormattingUpdated="@ColumnFormattingUpdated" />

@code {
    [Parameter]
    public bool IsVisible { get; set; }
    
    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }
    
    [Parameter]
    public EventCallback<ExcelExportOptions> OnExport { get; set; }
    
    [Parameter]
    public DataTable DataTable { get; set; } = null!;
    
    private ExcelExportOptions options = new();
    private List<string> tableStyles = new();
    private bool showColumnFormattingDialog = false;
    
    protected override void OnInitialized()
    {
        // Load saved settings
        options = SettingsService.GetSettings();
        
        // Get available table styles
        tableStyles = DatabaseService.GetAvailableTableStyles();
    }
    
    private async Task OnConfirm()
    {
        await OnExport.InvokeAsync(options);
        await CloseDialog();
    }
    
    private async Task OnCancel()
    {
        await CloseDialog();
    }
    
    private async Task CloseDialog()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(IsVisible);
    }
    
    private void SaveAsDefault()
    {
        SettingsService.SaveSettings(options);
    }
    
    private void ResetToDefaults()
    {
        options = new ExcelExportOptions();
    }
    
    private void ShowColumnFormatting()
    {
        if (DataTable == null || DataTable.Columns.Count == 0)
        {
            // Show error or warning
            return;
        }
        
        showColumnFormattingDialog = true;
    }
    
    private async Task PickSaveLocation()
    {
        try
        {
            var result = await FolderPicker.PickAsync(default);
            if (result.IsSuccessful)
            {
                options.CustomSavePath = result.Folder.Path;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Folder picking failed: {ex.Message}");
        }
    }
    
    private void ColumnFormattingUpdated()
    {
        // Refresh the UI
        StateHasChanged();
    }
}